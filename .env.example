# ===========================================================================
# .env.example — Production SaaS Configuration Contract (Task 8.20)
#
# Copy this file to .env and configure environment variables as needed.
# NEVER commit real credentials, tokens, or .env files to version control.
#
# Classification:
# - REQUIRED_IN_DEVELOPMENT: Minimum needed to boot local development.
# - REQUIRED_IN_STAGING: Needed for staging environments.
# - REQUIRED_IN_PRODUCTION: Mandatory for production cloud deployment.
# - OPTIONAL: Additive features (LLM copilot, live payment, outbound email).
# ===========================================================================

# ---------------------------------------------------------------------------
# 1. APPLICATION & RUNTIME (REQUIRED_IN_DEVELOPMENT / STAGING / PRODUCTION)
# ---------------------------------------------------------------------------
ENV=development                                      # development | staging | production
APP_NAME=LegislativeIntelligence
APP_PORT=8000
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=INFO                                      # DEBUG | INFO | WARNING | ERROR
JOB_EXECUTION_MODE=single_instance                  # single_instance | multi_instance | worker | scheduler

# ---------------------------------------------------------------------------
# 2. SECURITY & CORS (REQUIRED_IN_PRODUCTION)
# ---------------------------------------------------------------------------
SECRET_KEY=change_this_to_a_strong_random_secret_in_production
SESSION_COOKIE_NAME=legis_saas_session
CSRF_SECRET=change_this_csrf_secret_in_production
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000
RATE_LIMIT_ENABLED=false                            # Set true to enforce rate limiting
RATE_LIMIT_DEFAULT_RPM=120
RATE_LIMIT_AI_RPM=30
RATE_LIMIT_MONITORING_RPM=10

# ---------------------------------------------------------------------------
# 3. AUTHENTICATION & EXTERNAL IDP (REQUIRED_IN_PRODUCTION: JWT or OIDC)
# ---------------------------------------------------------------------------
# Production token signing key
JWT_SECRET_KEY=change_this_jwt_secret_in_production_32chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_SECONDS=86400

# External OIDC Identity Provider (Auth0, Okta, Google Identity)
# Leave blank for local development / testing; set for production external SSO.
# If absent: PRODUCTION_IDP_STATUS = NOT_CONFIGURED
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
OKTA_ISSUER=

# ---------------------------------------------------------------------------
# 4. DATABASE / PERSISTENCE (REQUIRED_IN_PRODUCTION)
# ---------------------------------------------------------------------------
# In development, local file-backed JSON repository is used by default.
# For production PostgreSQL:
# If absent: DATABASE_STATUS = NOT_CONFIGURED
DATABASE_URL=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=legislative_intel
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_TIMEOUT=10

# ---------------------------------------------------------------------------
# 5. REDIS / DISTRIBUTED INFRASTRUCTURE (REQUIRED_IN_PRODUCTION FOR MULTI-NODE)
# ---------------------------------------------------------------------------
# In development, thread-safe in-memory cache/lock provider is used by default.
# For production multi-container distributed locks and rate limiting:
# If absent: REDIS_STATUS = NOT_CONFIGURED
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TIMEOUT=2.0

# ---------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAIL (REQUIRED_IN_PRODUCTION FOR LIVE EMAIL)
# ---------------------------------------------------------------------------
# In development, safe DevelopmentEmailProvider simulates delivery in-memory.
# For production SMTP or SendGrid/Resend:
# If absent: EMAIL_STATUS = NOT_CONFIGURED
EMAIL_PROVIDER=smtp                                 # smtp | sendgrid | resend
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDER_EMAIL=notifications@legislative.gov.in
SENDGRID_API_KEY=
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# 7. BILLING & SUBSCRIPTIONS (OPTIONAL — SAAS TIER MANAGEMENT)
# ---------------------------------------------------------------------------
# In development, DevelopmentBillingProvider simulates upgrades and webhooks.
# For production live Stripe / Razorpay:
# If absent: BILLING_STATUS = NOT_CONFIGURED
BILLING_PROVIDER=stripe                             # stripe | razorpay
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---------------------------------------------------------------------------
# 8. GROQ AI INTELLIGENCE & EXPLANATION (OPTIONAL — EXTRACTIVE FALLBACK READY)
# ---------------------------------------------------------------------------
# If absent: AI_STATUS = NOT_CONFIGURED (offline extractive copilot remains active)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT=30.0
GROQ_MAX_TOKENS=1024
GROQ_TEMPERATURE=0.2

# ---------------------------------------------------------------------------
# 9. LEGISLATIVE MONITORING (REQUIRED_IN_PRODUCTION)
# ---------------------------------------------------------------------------
LEGISLATIVE_MONITOR_ENABLED=false
CENTRAL_MONITOR_INTERVAL=24
STATE_MONITOR_INTERVAL=48
MONITOR_MAX_RETRIES=3
MONITOR_TIMEOUT=60
